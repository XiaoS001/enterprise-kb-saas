# 复制为 .env 后按需改。.env 已被 .gitignore 排除，永不提交。

# --- 应用 ---
RMB01_PORT=5001
RMB01_HOST=127.0.0.1

# --- 密钥（生产必配）---
# RMB01_SECRET_KEY=请替换为随机长字符串
# RMB01_PASSWORD_SALT=请替换为随机长字符串

# --- 数据库 ---
# RMB01_DATA_DIR=./data
# RMB01_DATABASE_URL=sqlite:///./data/rmb01.db

# --- 检索 ---
# 🔴 向量检索默认关闭：嵌入模型要联网下载约 90MB，BM25 零依赖
RMB01_VECTOR_ENABLED=false

# --- 模型 ---
# 🔴 留空则问答走降级路径（只返回检索证据，不扣额度）
DEEPSEEK_API_KEY=
# RMB01_AI_MODEL=deepseek-chat
# RMB01_AI_BASE_URL=https://api.deepseek.com